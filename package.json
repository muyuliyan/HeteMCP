{
  "name": "heteromcp",
  "version": "0.2.0",
  "description": "Provider-neutral MCP orchestration for heterogeneous model workers.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:private && npm test",
    "check:private": "tsx scripts/check-private-traces.ts",
    "dev": "tsx watch src/index.ts",
    "db:down": "docker compose down --volumes --remove-orphans",
    "db:up": "docker compose up -d --wait postgres",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath githooks",
    "lint": "eslint .",
    "mcp:cc-switch": "tsx scripts/export-cc-switch.ts",
    "private:inventory": "tsx scripts/inventory-private-work.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http --port 8787",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:docker": "node --experimental-strip-types scripts/run-postgres-integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0"
  }
}
