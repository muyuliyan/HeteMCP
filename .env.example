# Example only: export variables into the service environment; .env is not auto-loaded.
# Unset HETEMCP_DATABASE_URL to use process-local in-memory task storage.
HETEMCP_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/heteromcp

# Optional Desktop 0.2.1-rc.2 file generation (otherwise the service uses fake).
# HETEMCP_DSH_DESKTOP=D:/path/to/deepseek-desktop
# HETEMCP_CREDENTIALS_PATH=C:/path/to/.credentials.yaml
# HETEMCP_ALLOW_UNMETERED=1
# HETEMCP_ARTIFACT_ROOT=.heteromcp/artifacts
