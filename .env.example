# Example only: export variables into the service environment; .env is not auto-loaded.
# Unset HETEMCP_DATABASE_URL to use process-local in-memory task storage.
HETEMCP_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/heteromcp

# Agent discovery. "auto" detects Claude Code, Codex and a configured DSH install.
HETEMCP_AGENTS=auto
# HETEMCP_DEFAULT_WORKER=claude

# Claude Code harness (optional; absolute .exe paths are preferred on Windows).
# HETEMCP_CLAUDE_EXECUTABLE=C:/Users/USER/.local/bin/claude.exe
# HETEMCP_CLAUDE_MODEL=sonnet

# Codex harness (optional; auto-detected from the Codex app when present).
# HETEMCP_CODEX_EXECUTABLE=C:/Users/USER/AppData/Local/OpenAI/Codex/bin/HASH/codex.exe
# HETEMCP_CODEX_MODEL=gpt-5

# Optional Desktop 0.2.1-rc.2 DSH file generation (otherwise fake).
# HETEMCP_DSH_DESKTOP=D:/path/to/deepseek-desktop
# HETEMCP_CREDENTIALS_PATH=C:/path/to/.credentials.yaml
# HETEMCP_ALLOW_UNMETERED=1
# HETEMCP_ARTIFACT_ROOT=.heteromcp/artifacts

# MCP transport. stdio is the default; http is for CC-switch or remote clients.
# HETEMCP_MCP_TRANSPORT=http
# HETEMCP_MCP_HOST=127.0.0.1
# HETEMCP_MCP_PORT=8787
# HETEMCP_MCP_PATH=/mcp
# HETEMCP_MCP_TOKEN=change-me

# Reviewers may only read artifacts under the configured artifact root by default.
# HETEMCP_ALLOW_EXTERNAL_ARTIFACTS=1
